SECRET_KEY=change-me-to-a-real-random-key
# True for local development only — must be False (or unset) in production.
DEBUG=True
# Comma-separated. Required if DEBUG=False, or Django rejects every request.
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL/MariaDB connection. Defaults below match a fresh local XAMPP install
# (root user, no password) — override any of these for a different environment.
DB_NAME=ednp_clergy_records
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Where uploaded documents and generated reports are kept. Leave BUCKET_NAME unset to keep them
# in MEDIA_ROOT on this machine's disk (fine for local development; on Railway that disk is
# replaced at every redeploy). To use a bucket, set all five; on Railway each is a reference to
# the bucket's own variable, e.g. BUCKET_NAME=${{Bucket.BUCKET}}. See resources/storage-bucket.md.
# BUCKET_NAME=
# BUCKET_ENDPOINT=
# BUCKET_REGION=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# Only if the bucket's Credentials tab says it needs path-style URLs:
# BUCKET_URL_STYLE=path

# Encryption at rest for uploaded documents and government ID numbers. Leave unset to store them
# unencrypted, as before. Make a key with:  python manage.py generate_data_key
# KEEP A COPY OF THE KEY SOMEWHERE SAFE THAT IS NOT THIS SERVER: without it, encrypted data (and the
# backups of it) is gone for good. Several keys may be listed, comma-separated: the first encrypts,
# all of them decrypt (that is how a key is replaced).
# DATA_ENCRYPTION_KEY=
# Set to True only after `python manage.py encrypt_existing_data` has run and nothing plaintext is left.
# DATA_ENCRYPTION_REQUIRED=False
