SECRET_KEY=change-me-to-a-real-random-key
# True for local development only — must be False (or unset) in production.
DEBUG=True
# Comma-separated. Required if DEBUG=False, or Django rejects every request.
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL/MariaDB connection. Defaults below match a fresh local XAMPP install
# (root user, no password) — override any of these for a different environment.
DB_NAME=ednp_clergy_records
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
